FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src

WORKDIR /app

COPY src/api/assistant/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Uniquement le code nécessaire à l'API principale (pas d'auth, pas de streamlit)
COPY src/api/assistant/ src/api/assistant/
COPY src/core/ src/core/
COPY src/memory/ src/memory/
COPY src/prompts/ src/prompts/

EXPOSE 8000
CMD ["uvicorn", "api.assistant.main:app", "--app-dir", "/app/src", "--host", "0.0.0.0", "--port", "8000"]
