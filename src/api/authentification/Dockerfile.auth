FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
WORKDIR /app

COPY src/api/authentification/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Uniquement le code nécessaire au service d'authentification
COPY src/api/authentification/auth.py src/api/authentification/auth.py
COPY src/core/schemas.py src/core/schemas.py

EXPOSE 8001
CMD ["uvicorn", "api.authentification.auth:app", "--app-dir", "/app/src", "--host", "0.0.0.0", "--port", "8001"]